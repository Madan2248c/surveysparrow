      "source": [
        "from datasets import load_dataset\n",
        "\n",
        "# Alpaca-style template\n",
        "alpaca_prompt = \"\"\"Below is an instruction that describes a task, paired with an input that provides further context. Write a response that appropriately completes the request.\n",
        "\n",
        "### Instruction:\n",
        "{}\n",
        "\n",
        "### Input:\n",
        "{}\n",
        "\n",
        "### Response:\n",
        "{}\"\"\"\n",
        "\n",
        "# Add EOS token for proper termination\n",
        "EOS_TOKEN = tokenizer.eos_token\n",
        "\n",
        "def formatting_prompts_func(examples):\n",
        "    inputs = examples[\"input\"]\n",
        "    outputs = examples[\"output\"]\n",
        "    styles = examples[\"style\"]\n",
        "    texts = []\n",
        "    for input_text, output_text, style_name in zip(inputs, outputs, styles):\n",
        "        # Make instruction explicit by including style info\n",
        "        instruction = f\"Rewrite the paragraph into my style.\"\n",
        "        text = alpaca_prompt.format(instruction, input_text, output_text) + EOS_TOKEN\n",
        "        texts.append(text)\n",
        "    return { \"text\" : texts }\n",
        "\n",
        "# Load dataset from your JSONL file\n",
        "dataset = load_dataset(\"json\", data_files=\"/content/style_transfer_dataset.jsonl\", split=\"train\")\n",
        "\n",
        "# Apply formatting\n",
        "dataset = dataset.map(formatting_prompts_func, batched=True)\n",
        "\n"
      ]
